# The trained model is regenerated by stage 2 on every pipeline run.
models/*
!models/.gitkeep
!models/README.md
mlruns/
mlartifacts/

# --- Airflow ---
services/airflow/logs/*
!services/airflow/logs/.gitkeep
services/airflow/plugins/*
!services/airflow/plugins/.gitkeep
airflow.db
standalone_admin_password.txt


# Copy to `.env` and adjust if the default ports are already taken on your machine.
# (docker compose picks up .env automatically)

# Host ports
AIRFLOW_PORT=8080
MLFLOW_PORT=5555
API_PORT=8000
APP_PORT=8501

# UID used inside the Airflow containers (keep 50000 unless you hit
# permission problems with the bind-mounted folders on Linux: `id -u`).
AIRFLOW_UID=50000

# Airflow web UI credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
